PORT=3000
HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=nail_management
NODE_ENV=development

# Khoá ký JWT. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mỗi máy một khoá khác nhau. File .env đã nằm trong .gitignore nên khoá
# này không bị đẩy lên Git.
JWT_SECRET=thay_bang_chuoi_ngau_nhien_64_ky_tu

# VNPay đặt cọc (lấy TmnCode + HashSecret ở sandbox.vnpayment.vn).
# Chưa có key thì cứ để trống: hệ thống tự dùng trang cọc giả lập,
# đổi sang VNPay thật chỉ cần điền key, không sửa code.
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay-return
# VNPAY_MOCK=true
# URL gọi hoàn tiền: mặc định theo sandbox/prod của VNPAY_URL.
# Chỉ cần đặt khi VNPay cấp endpoint riêng.
# VNPAY_API_URL=

# Telegram báo tin khẩn cấp ra điện thoại admin (nghỉ đột xuất...).
# Chưa có thì để trống: hệ thống bỏ qua êm, các kênh khác vẫn chạy.
# Cách lấy:
#   1. Nhắn cho @BotFather trên Telegram: /newbot → đặt tên → nhận token.
#   2. Admin nhắn một tin bất kỳ cho bot vừa tạo (hoặc mời bot vào nhóm).
#   3. Mở https://api.telegram.org/bot<token>/getUpdates tìm "chat":{"id":...}
#      → đó là chat id. Nhiều người/nhóm thì cách nhau bằng dấu phẩy.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# Gmail nhận tin khẩn cấp (nghỉ đột xuất...). Dùng "mật khẩu ứng dụng",
# KHÔNG phải mật khẩu đăng nhập Gmail. Cách lấy:
#   1. Vào myaccount.google.com → Bảo mật → bật "Xác minh 2 bước".
#   2. Vào myaccount.google.com/apppasswords (gõ lại mật khẩu nếu hỏi).
#   3. Tạo một mật khẩu ứng dụng (đặt tên "NailHouse") → copy 16 ký tự.
#   4. Điền Gmail + mật khẩu đó + (các) mail admin nhận tin dưới đây.
# Chưa điền thì hệ thống bỏ qua êm, các kênh khác vẫn chạy.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# ADMIN_EMAILS=
